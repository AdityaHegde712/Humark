# Humark Environment Configuration
# Copy this file to .env for local runtime configuration
# NEVER commit .env to version control

# Database
DATABASE_URL=postgresql+asyncpg://humark:humark_password@localhost:5432/humark
SYNC_DATABASE_URL=postgresql://humark:humark_password@localhost:5432/humark

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Model Baseline Seed (Zero-key deterministic mock runner default)
MOCK_MODEL_SEED=42

# Frontier Model API Keys (Optional - mock baseline runs out-of-the-box without keys)
# OpenRouter is the primary provider target for live models (supports free & paid frontier models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Environment (development, testing, production)
ENVIRONMENT=development
